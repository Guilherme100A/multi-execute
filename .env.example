HOST=127.0.0.1
PORT=3000
PIPELINE_TOKEN=replace-with-a-long-random-secret
INTERNAL_CALLBACK_TOKEN=replace-with-a-different-long-random-secret
RAM_URL=http://127.0.0.1:8080
MCP_URL=http://127.0.0.1:28429
# Port/host forms from the launcher specification (URL values above take precedence)
RAM_PORT=8080
MCP_HOST=127.0.0.1
MCP_PORT=28429
# Optional Bearer tokens for the upstream services
RAM_TOKEN=
MCP_TOKEN=
# REQUIRED: only games you own or have explicit permission to test
AUTHORIZED_PLACE_IDS=123456
ACCOUNTS_FILE=accounts.json
DB_PATH=data/sessions.sqlite
HEALTH_CHECK_INTERVAL_MS=30000
LAUNCH_TIMEOUT_MS=60000
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=2000
LOG_DIRECTORY=logs
FINDINGS_DIRECTORY=findings
