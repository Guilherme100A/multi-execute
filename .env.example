HOST=127.0.0.1
LAUNCH_BACKEND=direct
# Proxy UNICO, usado por todas as contas no login. Para varias contas, prefira o
# POOL abaixo (uma sessao sticky por conta) — proxy unico faz o Arkose contar
# todos os logins no mesmo IP e endurecer o captcha.
# BROWSER_PROXY_SERVER=http://proxy.example:10001
# BROWSER_PROXY_USERNAME=
# BROWSER_PROXY_PASSWORD=
# ── POOL DE PROXIES RESIDENCIAIS (opcional) ─────────────────────────────────
# Cada conta recebe uma sessao sticky propria, derivada do alias: a mesma conta
# sempre sai pelo mesmo IP, e contas diferentes por IPs diferentes. Preencha
# PROXY_HOST e o pool assume o lugar do proxy unico.
#
# O login e montado no formato da Proxy-Seller:
#   <PROXY_USERNAME>_c_<PROXY_COUNTRY>_s_<hash-do-alias>_ttl_<PROXY_TTL>
# Outros provedores usam outro formato — confira a documentacao antes.
# PROXY_HOST=res.proxy-seller.com     # us. | asia. | asia2. conforme a regiao
# PROXY_PORT=10000                    # 10000-10999: cada porta e um IP distinto
# PROXY_USERNAME=suacredencial
# PROXY_PASSWORD=suasenha
# PROXY_COUNTRY=BR                    # ISO 3166-1, 2 letras
# PROXY_TTL=15m                       # precisa cobrir o login inteiro (abrir
#                                     # janela + carregar + captcha + submit)
# PROXY_SCHEME=http                   # http | socks5
# ────────────────────────────────────────────────────────────────────────────
DIRECT_ACCOUNTS_FILE=data/roblox-accounts.dpapi
AUTO_CONNECT=true
# Optional override; normally detected in LOCALAPPDATA/Real/data/mcp/real-mcp.exe
# REAL_MCP_EXECUTABLE=C:\Users\you\AppData\Local\Real\data\mcp\real-mcp.exe
PORT=3000
# O Launcher gera credenciais internas temporárias automaticamente.
# Defina estas opções apenas se precisar mantê-las fixas entre reinícios.
# INTERNAL_CALLBACK_TOKEN=replace-with-a-long-random-secret
# AUTOEXEC_TOKEN=replace-with-a-different-long-random-secret
RAM_URL=http://127.0.0.1:7963
MCP_URL=http://127.0.0.1:28429
# Port/host forms from the launcher specification (URL values above take precedence)
RAM_PORT=7963
MCP_HOST=127.0.0.1
MCP_PORT=28429
INJECTION_MODE=project-real-autoexec
# RAM Developer Mode Webserver Password (query parameter required by RAM)
RAM_PASSWORD=
# Optional Bearer token if you put an authenticated proxy in front of MCP
MCP_TOKEN=
AGENT_CLI_COMMAND=codex.cmd
AGENT_MODEL=gpt-6.1-sol
# Solver de CAPTCHA do login Roblox (Arkose / Turnstile / image-grid).
# Para Arkose/FunCaptcha (o desafio do Roblox) so o 2Captcha atende: a CapSolver
# removeu o suporte a FunCaptcha da documentacao (verificado 2026-10). Para
# Turnstile a ordem e CapSolver e depois 2Captcha. Sem chave, o captcha e manual.
# TWOCAPTCHA_API_KEY=   <- necessario para Arkose
# CAPSOLVER_API_KEY=   <- util para Turnstile
# Saida usada pelo solver. Pelo padrao herda o proxy do navegador (BROWSER_PROXY_*)
# para o token sair do mesmo IP que faz o login. E heuristica de consistencia, nao
# exigencia documentada por Arkose, CapSolver ou 2Captcha.
# CAPTCHA_PROXY=usuario:senha@host:porta
# REQUIRED: only games you own or have explicit permission to test
AUTHORIZED_PLACE_IDS=123456
ACCOUNTS_FILE=accounts.json
DB_PATH=data/sessions.sqlite
HEALTH_CHECK_INTERVAL_MS=3000
LAUNCH_TIMEOUT_MS=120000
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=2000
LOG_DIRECTORY=logs
FINDINGS_DIRECTORY=findings
